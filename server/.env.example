# Copy to server/.env and fill in your own values.

MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/Rag-Knowledge-base?authSource=admin

CHAT_MODEL=gemma4:latest
SUMMARY_MODEL=gemma4:latest
EMBED_MODEL=nomic-embed-text

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=8192
CHAT_NUM_PREDICT=1024

# Local ONNX reranker (must be a sequence-classification model that ships ONNX files)
RERANK_MODEL=Xenova/bge-reranker-base
RERANK_DTYPE=q8
RERANK_THREADS=2
RERANK_WARMUP=true
EMBED_WARMUP=true

SSE_HEARTBEAT_MS=10000
CHAT_TIMEOUT_MS=300000

STUDY_EXCERPT_CHARS=16000
STUDY_QUIZ_QUESTIONS=10
STUDY_NUM_PREDICT=1800
STUDY_TIMEOUT_MS=240000
